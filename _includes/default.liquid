---
title: My Rad Blog
---

<!doctype html>
<html lang="en">
  <head>
    <link href="http://gmpg.org/xfn/11" rel="profile">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
  
    <!-- Enable responsiveness on mobile devices-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
  
    <title>
      {% if title == "Home" %}
        {{ site.title }}
      {% else %}
        {{ title }} &middot; {{ site.title }}
      {% endif %}
    </title>
  
    <!-- CSS -->
    <link rel="stylesheet" href="{{ '/public/css/poole.css' }}">
    <link rel="stylesheet" href="{{ '/public/css/syntax.css' }}">
    <link rel="stylesheet" href="{{ '/public/css/hyde.css' }}">
    <link rel="stylesheet" href="http://fonts.googleapis.com/css?family=PT+Sans:400,400italic,700|Abril+Fatface">
  
    <!-- Icons -->
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="{{ '/public/apple-touch-icon-144-precomposed.png' }}">
                                   <link rel="shortcut icon" href="{{ '/public/favicon.ico' }}">
  
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/atom.xml">
  </head>

  <body class="theme-base-0d">

    <div class="sidebar" style="text-align: left">
      <div class="container sidebar-sticky">
        <div class="sidebar-photo" style="display: flex; justify-content: center;">
          <img src="{{ '/public/img/main.jpg' }}" alt="Profile Photo" style="width: 10vw; height: 10vw; border-radius: 50%; object-fit: cover;">
        </div>

        <div class="sidebar-about">
          <h1>
            <a href="{{ site.baseurl }}">{{ site.title }}</a>
          </h1>
          <p class="lead">{{ site.description }}</p>
        </div>

        <!--
        <nav class="sidebar-nav">
          <a class="sidebar-nav-item{% if entry == node %} active{% endif %}" href="/">Home</a>
          {% for node in site.pages %}
            <a class="sidebar-nav-item{% if entry == node %} active{% endif %}" href="{{ node.url }}">{{ node.name }}</a>
            {%if node.children %}
            <ul>
              {% for item in node.children %}
                <li style="font-size: 0.75em;">
                  <a class="sidebar-nav-item{% if entry == node %} active{% endif %}" href="{{ item[1] }}">{{ item[0] }}</a>
                </li>
              {% endfor %}
            </ul>
            {% endif %}
          {% endfor %}
        </nav>
        -->

<nav class="sidebar-nav">
  {% for node in site.pages %}
    {% if node.children %}
      <details class="sidebar-dropdown">
        <summary class="sidebar-nav-item{% if entry == node %} active{% endif %}" style="color: rgba(255, 255, 255)">
          <span class="dropdown-label active">{{ node.name }}</span>
          <span class="arrow"></span>
        </summary>
        <div class="sidebar-dropdown-content">
          {% for item in node.children %}
            <a class="sidebar-nav-item{% if entry == item %} active{% endif %}" 
               href="{{ item[1] }}" 
               style="font-size: 0.85em; display: block; padding-left: 1.25em;">
              {{ item[0] }}
            </a>
          {% endfor %}
        </div>
      </details>
    {% else %}
      <a class="sidebar-nav-item{% if entry == node %} active{% endif %}" href="{{ node.url }}" style="color: rgba(255, 255, 255)">
        {{ node.name }}
      </a>
    {% endif %}
  {% endfor %}
</nav>


<style>
.sidebar-dropdown summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.4em 0;
  font-weight: 500;
}

.sidebar-dropdown summary::-webkit-details-marker {
  display: none; /* hide default arrow */
}

.arrow {
  display: inline-block;
  width: 0.5em;
  height: 0.5em;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(-45deg);
  transition: transform 0.2s ease;
  margin-left: 0.4em;
}

.sidebar-dropdown[open] .arrow {
  transform: rotate(45deg);
}

.sidebar-dropdown-content {
  margin-left: 1rem;
  padding-top: 0.25rem;
}

.sidebar-nav-item {
  display: block;
  text-decoration: none;
}

.sidebar-nav-item.active {
  font-weight: bold;
}
</style>



      </div>
    </div>

    <div class="content container" style="max-width: none">
      {{ content }}
    </div>
  </body>
</html>
